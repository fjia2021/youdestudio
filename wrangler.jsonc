{
  "name": "youdestudio",
  "compatibility_date": "2026-11-15",
  "routes": [
    { "pattern": "youdestudio.com", "custom_domain": true },
    { "pattern": "www.youdestudio.com", "custom_domain": true }
  ],
  "main": "src/worker.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "CONTACT_MAIL" }
  ]
}
